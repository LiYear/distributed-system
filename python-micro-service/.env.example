# ============================================
# 微服务项目环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================

# ---- Nacos 注册中心 ----
NACOS_SERVER=localhost:8848

# ---- JWT 认证（Gateway + User-Service 共用）----
JWT_SECRET=change-me-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ---- MySQL 数据库 ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
# 各服务独立数据库（分库）
DB_NAME_USER=db_user
DB_NAME_GOODS=db_goods
DB_NAME_ORDER=db_order

# ---- Redis 缓存 ----
REDIS_URL=redis://localhost:6379

# ---- RabbitMQ 消息队列 ----
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123

# ---- 网关限流配置 ----
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=1

# ---- 网关熔断配置 ----
CB_FAILURE_THRESHOLD=5
CB_TIMEOUT_SECONDS=30

# ---- CORS 跨域（逗号分隔允许的前端来源）----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ---- 服务注册 IP/端口（可选，默认 127.0.0.1）----
SERVICE_IP=127.0.0.1
GATEWAY_PORT=8000
USER_SERVICE_PORT=8001
GOODS_SERVICE_PORT=8002
ORDER_SERVICE_PORT=8003
